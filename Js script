let cart = [],
  wishlist = [],
  currentProducts = products;

function login() {
  const user = document.getElementById("loginUser").value.trim(),
    pass = document.getElementById("loginPassword").value.trim(),
    error = document.getElementById("errorMsg");
  if (user === "" || pass === "") {
    error.textContent = "Please enter your email/mobile and password.";
    return;
  }
  error.textContent = "";
  document.getElementById("loginPage").style.display = "none";
  document.getElementById("app").style.display = "block";
  loadCategories();
  displayProducts(products);
}
function togglePassword() {
  const input = document.getElementById("loginPassword");
  input.type = input.type === "password" ? "text" : "password";
}
function forgotPassword() {
  alert(
    "Password reset can be connected with Email/OTP in the backend version."
  );
}
function createAccount() {
  alert("Registration page can be added in the next version.");
}
function logout() {
  document.getElementById("app").style.display = "none";
  document.getElementById("loginPage").style.display = "flex";
  document.getElementById("loginUser").value = "";
  document.getElementById("loginPassword").value = "";
}
function loadCategories() {
  const container = document.getElementById("categories"),
    cats = ["All", ...new Set(products.map((p) => p.category))];
  container.innerHTML = "";
  cats.forEach((cat) => {
    const button = document.createElement("button");
    button.className = "category-btn" + (cat === "All" ? " active" : "");
    button.textContent = cat;
    button.onclick = () => {
      document
        .querySelectorAll(".category-btn")
        .forEach((b) => b.classList.remove("active"));
      button.classList.add("active");
      filterCategory(cat);
    };
    container.appendChild(button);
  });
}
function displayProducts(list) {
  currentProducts = list;
  const grid = document.getElementById("productGrid"),
    count = document.getElementById("productCount");
  grid.innerHTML = "";
  count.textContent = list.length + " products";
  if (list.length === 0) {
    grid.innerHTML =
      '<div class="empty"><h3>No products found 😔</h3><p>Try another product or category.</p></div>';
    return;
  }
  list.forEach((product) => {
    const card = document.createElement("div");
    card.className = "product-card";
    const discount = Math.round(
      ((product.old - product.price) / product.old) * 100
    );
    card.innerHTML = `<div class="product-image"><img src="${ product.image }" alt="${ product.name }" onerror="this.src='https://via.placeholder.com/500?text=SP+MART'"><button class="wish" onclick="toggleWishlist(${ product.id })">${wishlist.includes(product.id) ? "❤️" : "♡"}</button></div> <div class="product-info"><div class="brand-name">${ product.brand }</div><div class="product-name">${product.name}</div><div class="rating">⭐ ${ product.rating }</div> <div class="price">₹${product.price.toLocaleString( "en-IN" )} <span class="old-price">₹${product.old.toLocaleString( "en-IN" )}</span><span class="discount">${discount}% OFF</span></div> <div class="delivery">🚚 Delivery in 3–5 working days</div><div class="product-buttons"><button class="add-btn" onclick="addToCart(${ product.id })">Add to Cart</button><button class="buy-btn" onclick="buyNow(${ product.id })">Buy Now</button></div></div>`;
    grid.appendChild(card);
  });
}
function searchProducts() {
  const text = document
    .getElementById("searchInput")
    .value.toLowerCase()
    .trim();
  if (text === "") {
    document.getElementById("sectionTitle").textContent =
      "Trending Electronics";
    displayProducts(products);
    return;
  }
  const result = products.filter(
    (product) =>
      product.name.toLowerCase().includes(text) ||
      product.brand.toLowerCase().includes(text) ||
      product.category.toLowerCase().includes(text)
  );
  document.getElementById("sectionTitle").textContent = "Search Results";
  displayProducts(result);
}
function filterCategory(category) {
  document.getElementById("searchInput").value = "";
  if (category === "All") {
    document.getElementById("sectionTitle").textContent =
      "Trending Electronics";
    displayProducts(products);
    return;
  }
  const result = products.filter((product) => product.category === category);
  document.getElementById("sectionTitle").textContent = category;
  displayProducts(result);
}
function addToCart(id) {
  const existing = cart.find((item) => item.id === id);
  if (existing) existing.qty++;
  else cart.push({ id, qty: 1 });
  updateCartCount();
  alert("Product added to cart 🛒");
}
function buyNow(id) {
  cart = [{ id, qty: 1 }];
  updateCartCount();
  openCheckout();
}
function updateCartCount() {
  document.getElementById("cartCount").textContent = cart.reduce(
    (total, item) => total + item.qty,
    0
  );
}
function showCart() {
  renderCart();
  document.getElementById("cartModal").style.display = "flex";
}
function renderCart() {
  const container = document.getElementById("cartItems"),
    totalBox = document.getElementById("cartTotal");
  if (cart.length === 0) {
    container.innerHTML =
      '<div class="empty"><h3>Your cart is empty 🛒</h3><p>Add products to continue shopping.</p></div>';
    totalBox.innerHTML = "";
    return;
  }
  let total = 0;
  container.innerHTML = "";
  cart.forEach((item) => {
    const product = products.find((p) => p.id === item.id),
      amount = product.price * item.qty;
    total += amount;
    container.innerHTML += `<div class="cart-item"><img src="${ product.image }"><div class="cart-details"><strong>${product.name}</strong><div>${ product.brand }</div><b>₹${product.price.toLocaleString( "en-IN" )}</b><div class="qty"><button onclick="changeQty(${ product.id },-1)">−</button><span>${item.qty}</span><button onclick="changeQty(${ product.id },1)">+</button></div></div><button class="remove" onclick="removeFromCart(${ product.id })">Remove</button></div>`;
  });
  totalBox.innerHTML = `<div class="total-box"><div class="total-row"><span>Subtotal</span><strong>₹${total.toLocaleString( "en-IN" )}</strong></div><div class="total-row"><span>Delivery</span><strong>FREE</strong></div><hr><div class="total-row grand"><span>Total</span><strong>₹${total.toLocaleString( "en-IN" )}</strong></div><button class="main-btn" style="margin-top:15px" onclick="openCheckout()">PROCEED TO CHECKOUT</button></div>`;
}
function changeQty(id, value) {
  const item = cart.find((i) => i.id === id);
  if (!item) return;
  item.qty += value;
  if (item.qty <= 0) cart = cart.filter((i) => i.id !== id);
  updateCartCount();
  renderCart();
}
function removeFromCart(id) {
  cart = cart.filter((item) => item.id !== id);
  updateCartCount();
  renderCart();
}
function toggleWishlist(id) {
  if (wishlist.includes(id)) wishlist = wishlist.filter((item) => item !== id);
  else wishlist.push(id);
  displayProducts(currentProducts);
}
function showWishlist() {
  const container = document.getElementById("wishlistItems"),
    items = products.filter((product) => wishlist.includes(product.id));
  if (items.length === 0)
    container.innerHTML =
      '<div class="empty"><h3>Your wishlist is empty ❤️</h3></div>';
  else {
    container.innerHTML = "";
    items.forEach(
      (product) =>
        (container.innerHTML += `<div class="cart-item"><img src="${ product.image }"><div class="cart-details"><strong>${product.name}</strong><div>${ product.brand }</div><b>₹${product.price.toLocaleString( "en-IN" )}</b></div><button class="remove" onclick="toggleWishlist(${ product.id });showWishlist();">Remove</button></div>`)
    );
  }
  document.getElementById("wishlistModal").style.display = "flex";
}
function openCheckout() {
  if (cart.length === 0) {
    alert("Your cart is empty.");
    return;
  }
  closeModal("cartModal");
  let total = 0;
  cart.forEach((item) => {
    const product = products.find((p) => p.id === item.id);
    total += product.price * item.qty;
  });
  document.getElementById(
    "checkoutSummary"
  ).innerHTML = `<div class="total-box"><div class="total-row"><span>Order Total</span><strong>₹${total.toLocaleString( "en-IN" )}</strong></div><div class="delivery">🚚 Estimated Delivery: 3–5 working days</div></div>`;
  document.getElementById("checkoutModal").style.display = "flex";
}
function goToPayment(event) {
  event.preventDefault();
  const selected = document.querySelector(
    'input[name="payment"]:checked'
  ).value;
  closeModal("checkoutModal");
  const box = document.getElementById("paymentBox");
  let total = 0;
  cart.forEach((item) => {
    const product = products.find((p) => p.id === item.id);
    total += product.price * item.qty;
  });
  if (selected === "COD")
    box.innerHTML = `<div style="text-align:center"><h3>💵 Cash on Delivery</h3><p style="margin:15px 0">Pay when your order is delivered.</p><h2>₹${total.toLocaleString( "en-IN" )}</h2><button class="main-btn" style="margin-top:20px" onclick="confirmOrder()">PLACE ORDER</button></div>`;
  else
    box.innerHTML = `<div style="text-align:center"><h3>📱 ${selected} Payment</h3><p style="margin:12px 0">Payment amount:</p><h2>₹${total.toLocaleString( "en-IN" )}</h2><div style="margin:20px auto;padding:18px;background:#f5f7fb;border-radius:12px;text-align:left"><label>UPI ID</label><input id="upiId" placeholder="example@upi" style="width:100%;padding:12px;margin-top:7px;border:1px solid #ddd;border-radius:8px"></div><p style="font-size:13px;color:#777">Demo payment flow. No real payment credentials are processed.</p><button class="main-btn" style="margin-top:18px" onclick="confirmOrder()">PAY ₹${total.toLocaleString( "en-IN" )}</button></div>`;
  document.getElementById("paymentModal").style.display = "flex";
}
